# # ---- Server ----
# NODE_ENV=development
# PORT=5000

# # ---- Database ----
# # MongoDB connection string (MongoDB Atlas or local mongod)
# MONGO_URI=mongodb://127.0.0.1:27017/sai_trust

# # ---- Auth ----
# # Long, random secrets in production (openssl rand -hex 64)
# JWT_SECRET=change_this_to_a_long_random_secret
# JWT_EXPIRES_IN=7d

# # ---- CORS ----
# # Comma-separated list of allowed frontend origins (no trailing slash)
# CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# # ---- File uploads ----
# # "local" stores files on disk under /uploads and serves them statically.
# # Swap to a cloud provider later without changing controller code by
# # implementing the same saveFile()/deleteFile() interface in utils/storage.js.
# UPLOAD_DRIVER=local
# MAX_IMAGE_SIZE_MB=5
# MAX_VIDEO_SIZE_MB=50
# # Public base URL used to build absolute file URLs returned by /api/upload
# PUBLIC_BASE_URL=http://localhost:5000

# # ---- Email (contact form notifications) ----
# # Leave blank to disable email sending (contact form will still save to DB).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="SAI Trust Website" <no-reply@saitrustkovilpatti.org>

# # ---- Seed / bootstrap admin (used by `npm run seed`) ----
# SEED_ADMIN_NAME=Trust Admin
# SEED_ADMIN_EMAIL=admin@saitrust.demo
# SEED_ADMIN_PASSWORD=Admin@1234
